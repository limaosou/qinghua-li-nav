# 服务端口
PORT=3000
# 监听地址，服务器上保持 0.0.0.0
HOST=0.0.0.0

# ===== 管理员账号 =====
ADMIN_USERNAME=admin
# 推荐：scrypt 哈希密码（用 `npm run hash-password` 生成后粘贴到这里）
ADMIN_PASSWORD_HASH=
# 备选：明文密码（仅本地测试用，生产环境请用上面的哈希）
# ADMIN_PASSWORD=

# Token 签名密钥，务必改成一段长随机字符串
TOKEN_SECRET=please-change-me-to-a-long-random-string

# SQLite 数据文件目录（相对项目根目录，建议加入定时备份）
DATA_DIR=./data

# ===== 自动部署 Webhook（可选，留空则禁用）=====
# 配后：push 到 main 即自动 git pull + 重启；GitHub Webhook 用 x-hub-signature-256 校验
# 也支持手动 GET /api/deploy?token=WEBHOOK_SECRET 触发（token 会进日志，仅临时用）
WEBHOOK_SECRET=

# ===== 搜索引擎主动提交（可选，留空则跳过；见 README「搜索引擎主动提交」）=====
# 百度搜索资源平台 ziyuan.baidu.com → 普通收录 → 接口调用 里拿 token
BAIDU_ZZ_TOKEN=
# 百度站点域名（默认取 SITE_URL 的主机名，若平台用裸域请改成 liqinghua.com）
# BAIDU_SITE=www.liqinghua.com
# 必应 / Bing（同时喂给 ChatGPT / Copilot）走 IndexNow，自行设定一段随机 key 即可
# 脚本会自动在 public/<key>.txt 生成校验文件
# BING_INDEXNOW_KEY=
# 站点地址（部署后主动推送抓取的 sitemap 来源）
SITE_URL=https://www.liqinghua.com
